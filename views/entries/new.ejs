<h1>Add a Journal Entry!</h1>
<form action="/entries/new" method="POST">
  <label for="content">Entry</label>
  <textarea id="content" name="content" rows="8" cols="60" required></textarea>
  <br />
  <div>
  <label for="mood-select">Mood (Optional):</label>
  <select id="mood-select" name="mood">
    <option value="" selected>No mood</option>
    <option value="Happy">Happy</option>
    <option value="Sad">Sad</option>
    <option value="Focused">Focused</option>
    <option value="Stressed">Stressed</option>
    <option value="Calm">Calm</option>
  </select>
</div>
  <button type="submit">Save Entry</button>
</form>
